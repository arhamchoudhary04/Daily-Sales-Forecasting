{
  "name": "ts-forecast-mlops",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": false }
  },
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "frontend" },
    "8000": { "label": "backend" }
  },
  "onCreateCommand": "bash .devcontainer/install-k8s-tools.sh",
  "postCreateCommand": "pip install --index-url https://download.pytorch.org/whl/cpu torch && pip install -r backend/requirements-dev.txt -r backend/requirements-train.txt && (cd frontend && npm ci)",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"]
    }
  }
}
